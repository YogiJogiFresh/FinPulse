{
  "name": "finpulse-electron",
  "version": "1.5.6",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc && electron-builder",
    "test:scheduler": "tsc && node --test tests/plaid-schedule.test.js",
    "test:notifications": "tsc && electron tests/notification-storage.test.js",
    "test:backups": "tsc && electron tests/backup-storage.test.js",
    "test:profiles": "tsc && electron tests/runtime-profile.test.js",
    "test:plaid-link": "tsc && node --test tests/plaid-hosted-link.test.js",
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "finpulse": "file:..",
    "plaid": "^47.0.0",
    "sql.js": "^1.11.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.finpulse.app",
    "productName": "FinPulse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/sql.js/dist/sql-wasm.js"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client"
      },
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FinPulse",
      "uninstallDisplayName": "FinPulse"
    },
    "publish": {
      "provider": "github",
      "owner": "YogiJogiFresh",
      "repo": "FinPulse"
    }
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
